{
  "name": "sap-event-registration",
  "version": "0.1.0",
  "description": "Feasibility study: the coderdojo-event-registration data model on SAP CAP",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@sap/cds": "^9.9.3",
    "express": "^4"
  },
  "devDependencies": {
    "@cap-js/cds-test": "^0.4",
    "@cap-js/sqlite": "^2.4.1",
    "@sap/cds-dk": "^9.9.6",
    "@cap-js/cds-typer": "^0.41.1",
    "@cap-js/cds-types": "^0.20.0",
    "@types/node": "^24.0.0",
    "tsx": "^4",
    "typescript": "^6.0.0",
    "cds-plugin-ui5": "^0.17.4"
  },
  "scripts": {
    "start": "cds-serve",
    "watch": "cds-tsx watch",
    "build": "npm run typer && cds build --production",
    "test": "npm run typer && CDS_TYPESCRIPT=true node --import tsx --test test/*.test.ts",
    "dev:site": "npm run dev -w app/site",
    "build:site": "npm run build -w app/site",
    "typer": "cds-typer \"*\" --outputDirectory @cds-models",
    "typecheck": "npm run typer && tsc --noEmit && npm run typecheck --workspaces"
  },
  "cds": {
    "requires": {
      "db": {
        "kind": "sqlite",
        "credentials": {
          "url": ":memory:"
        }
      },
      "auth": {
        "kind": "mocked",
        "users": {
          "parent": {
            "password": "",
            "roles": [
              "family"
            ],
            "attr": {
              "account": "a0000000-0000-0000-0000-000000000001"
            }
          },
          "other-parent": {
            "password": "",
            "roles": [
              "family"
            ],
            "attr": {
              "account": "a0000000-0000-0000-0000-000000000003"
            }
          },
          "champion": {
            "password": "",
            "roles": [
              "dojo-team"
            ],
            "attr": {
              "account": "a0000000-0000-0000-0000-000000000002"
            }
          },
          "orgadmin": {
            "password": "",
            "roles": [
              "organisation-admin"
            ]
          },
          "reviewer": {
            "password": "",
            "roles": [
              "reviewer"
            ]
          }
        }
      },
      "[production]": {
        "db": "hana",
        "auth": "xsuaa"
      }
    }
  },
  "imports": {
    "#cds-models/*": "./@cds-models/*/index.js"
  },
  "workspaces": [
    "app/*"
  ]
}
