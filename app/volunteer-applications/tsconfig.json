{
  "compilerOptions": {
    "target": "es2023",
    "module": "es2022",
    "moduleResolution": "node",
    "skipLibCheck": true,
    "allowJs": false,
    "strict": true,
    "strictPropertyInitialization": false,
    "noEmit": true,
    "rootDir": "./webapp",
    "baseUrl": "./",
    "types": [
      "@sapui5/types"
    ],
    "paths": {
      "coderdojo/volunteerapplications/*": [
        "./webapp/*"
      ]
    }
  },
  "include": [
    "./webapp/**/*"
  ]
}
