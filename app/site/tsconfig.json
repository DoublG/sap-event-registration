{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["vite/client"],
    "paths": {
      // The CAP model's entity types (generated by `npm run typer` in the
      // project root), so the site and the services share one definition.
      "#cds-models/*": ["../../@cds-models/*"],
      "@sap/cds": ["../../node_modules/@cap-js/cds-types"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "vite.config.ts"]
}
